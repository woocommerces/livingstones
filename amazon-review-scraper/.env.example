APP_NAME="Amazon Review Scraper"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=amazon_reviews
DB_USERNAME=scraper
DB_PASSWORD=scraper_password

CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

SCRAPER_DELAY_MIN=3
SCRAPER_DELAY_MAX=8
SCRAPER_MAX_RETRIES=3
SCRAPER_TIMEOUT=30
SCRAPER_CONCURRENT_TASKS=2
SCRAPER_MAX_PAGES=100
SCRAPER_IMAGES_ENABLED=true
SCRAPER_VIDEOS_ENABLED=true

STORAGE_PATH=uploads
IMAGES_PATH=uploads/images
VIDEOS_PATH=uploads/videos
MAX_IMAGE_SIZE=5242880
MAX_VIDEO_SIZE=104857600

TIMEZONE=Asia/Shanghai
LOG_LEVEL=info
